GEMINI_API_KEY=your_api_key
# Chỉ chọn một trong hai: gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
NAME_CHATBOT=OLP AI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/chatbot

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Context của chatbot và model summary được cấu hình độc lập.
CHAT_CONTEXT_WINDOW_TOKENS=10000
# Input summary tối đa = context summary - output summary (15000 - 1500 = 13500).
SUMMARY_CONTEXT_WINDOW_TOKENS=15000
# Tổng token ước lượng của nội dung user + assistant được lưu trong một hội thoại.
MAX_CONVERSATION_TOKENS=100000

# Phân bổ context chatbot: input 75%, output 25%.
MAX_INPUT_RATIO=0.75
MAX_SYSTEM_PROMPT_RATIO=0.05
MAX_USER_INPUT_RATIO=0.10
MAX_HISTORY_SUMMARY_RATIO=0.15
MAX_HISTORY_RECENT_MESSAGES_RATIO=0.45
# Khi recent vượt 45%, tóm tắt các cặp message cũ để recent về gần 30%.(<=30%)
TARGET_HISTORY_RECENT_MESSAGES_RATIO=0.30
MAX_OUTPUT_RATIO=0.25

# Ngưỡng an toàn phụ cho trường hợp có rất nhiều message cực ngắn.
RECENT_MESSAGE_LIMIT=200
# Chỉ gọi Gemini count_tokens khi ước lượng đạt từ 95% ngân sách tương ứng.
EXACT_TOKEN_COUNT_THRESHOLD=0.95

# V4.2 rollout: bật QUEUE trước, rồi ASYNC backend và frontend theo từng bước.
ASYNC_CHAT_ENABLED=false
LEGACY_SYNC_CHAT_ENABLED=true
QUEUE_ENABLED=false

# Redis bắt buộc khi bật queue/async. Production nên bật persistence AOF.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2

USER_RATE_CAPACITY=10
USER_RATE_REFILL_TOKENS=10
USER_RATE_REFILL_SECONDS=60
MAX_ACTIVE_GENERATIONS_PER_USER=3
MAX_ACTIVE_GENERATIONS_PER_CONVERSATION=1

MAX_QUEUE_SIZE=1000
MAX_QUEUE_WAIT_SECONDS=900
QUEUE_EVENT_TTL_SECONDS=3600
QUEUE_JOB_MAX_ATTEMPTS=4
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=60

GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRY_ATTEMPTS=3
GEMINI_MAX_RETRY_ELAPSED_SECONDS=90
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=20

# CẢNH BÁO: quota dưới đây chỉ là ví dụ bảo thủ. Kiểm tra Dashboard > Rate Limit
# trong Google AI Studio của đúng project/tier/model trước khi production.
GEMINI_QUOTA_PROJECT_ID=replace_with_real_project_id
# Ba cấu hình model bên dưới chỉ nhận một trong hai ID ghi ở GEMINI_MODEL.
DEFAULT_MODEL_NAME=gemini-3.5-flash-lite
DEFAULT_MODEL_RPM=5
DEFAULT_MODEL_INPUT_TPM=10000
DEFAULT_MODEL_RPD=100
SUMMARY_MODEL_NAME=gemini-3.1-flash-lite
SUMMARY_MODEL_RPM=5
SUMMARY_MODEL_INPUT_TPM=10000
SUMMARY_MODEL_RPD=100
ADVANCED_MODEL_NAME=gemini-3.5-flash-lite
ADVANCED_MODEL_RPM=5
ADVANCED_MODEL_INPUT_TPM=10000
ADVANCED_MODEL_RPD=100
SAFE_RPM_RATIO=0.9
SAFE_TPM_RATIO=0.9
SAFE_RPD_RATIO=0.9
FALLBACK_ENABLED=true

# Chỉ bỏ comment khi migrate database v2 đang có hội thoại.
# V2_OWNER_EMAIL=owner@example.com
# V2_OWNER_PASSWORD=change_this_password
