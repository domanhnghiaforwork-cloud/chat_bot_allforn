# Docker Compose project/image settings
COMPOSE_PROJECT_NAME=chatbot-v42
IMAGE_TAG=latest
APP_PORT=3000

# Optional public tunnel. Only used with: docker compose --profile tunnel up -d
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
NGROK_INSPECTOR_PORT=4040

# PostgreSQL. Use a long URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password

# Runtime sizing. Increase only after measuring CPU/RAM and database connections.
API_WORKERS=2

# Keep backend and frontend rollout flags aligned. QUEUE_ENABLED must be true
# whenever ASYNC_CHAT_ENABLED is true.
ASYNC_CHAT_ENABLED=true
QUEUE_ENABLED=true
